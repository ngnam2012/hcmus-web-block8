{
  "name": "hcmus-web-block9",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "ui": "node --env-file-if-exists=.env src/lab-ui.js",
    "sender-api": "node --env-file-if-exists=.env src/sender-api.js",
    "relay": "node --env-file-if-exists=.env src/relay.js",
    "receiver-api": "node --env-file-if-exists=.env src/receiver-api.js",
    "receiver-worker": "node --env-file-if-exists=.env src/receiver-worker.js",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "seed": "node --env-file-if-exists=.env scripts/migrate.js --reset",
    "proc": "node --env-file-if-exists=.env scripts/process-ctl.js",
    "test": "node --test test/unit.test.js",
    "verify": "node --env-file-if-exists=.env scripts/harness.js all",
    "verify:automated": "node --env-file-if-exists=.env scripts/harness.js automated",
    "verify:kills": "node --env-file-if-exists=.env scripts/harness.js kills",
    "snapshot": "node --env-file-if-exists=.env scripts/snapshot.js",
    "report": "node --env-file-if-exists=.env scripts/report.js"
  },
  "dependencies": {
    "express": "5.1.0",
    "pg": "8.16.3"
  }
}
