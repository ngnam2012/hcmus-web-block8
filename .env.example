# Docker Compose reads these automatically. Local-only lab credentials.
API_PORT=3000
MOCK_PORT=3001
PG_PORT=5438
AMQP_PORT=5678
RABBIT_ADMIN_PORT=15678
APP_VERSION=V3
# For running Node outside containers (Compose overrides these inside).
DATABASE_URL=postgres://lab:lab@127.0.0.1:5438/broker_lab
AMQP_URL=amqp://lab:lab@127.0.0.1:5678
RABBIT_MANAGEMENT_URL=http://127.0.0.1:15678
MOCK_URL=http://127.0.0.1:3001
