# Copy this file to .env and replace WEBHOOK_SECRET with your own local value.
# Never commit real secrets into .env.example or git.

# Loopback ports on host
PG_PORT=5439
SENDER_PORT=4000
RECEIVER_PORT=4100
RELAY_HEALTH_PORT=4002
WORKER_HEALTH_PORT=4102

# Two logically independent PostgreSQL databases on the same server
PG_ADMIN_DATABASE_URL=postgres://lab:lab@127.0.0.1:5439/postgres
SENDER_DATABASE_URL=postgres://lab:lab@127.0.0.1:5439/sender_db
RECEIVER_DATABASE_URL=postgres://lab:lab@127.0.0.1:5439/receiver_db

# Webhook security and fixed loopback target (replace secret in .env)
WEBHOOK_SECRET=replace-with-local-lab-secret
WEBHOOK_SOURCE=sender-lab
WEBHOOK_TARGET_URL=http://127.0.0.1:4100/webhooks/summaries

# Lab timing policies (matches Block 9 specification)
WEBHOOK_TIMEOUT_MS=2000
WEBHOOK_TIMESTAMP_WINDOW_SEC=300
RELAY_POLL_INTERVAL_MS=100
WORKER_POLL_INTERVAL_MS=100

# Enable loopback-only lab fault endpoints (/_lab/fault) and markers
LAB_MODE=true
